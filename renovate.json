{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "schedule:weekly"],
  "minimumReleaseAge": "7 days",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  },
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "description": "GitHub Actions のコミット固定は .github/workflows/actions.lock が担う (Renovate が更新時に再生成する)。uses: への digest 固定と二重管理にしない",
      "matchManagers": ["github-actions"],
      "pinDigests": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "actions-lock.yml: gh-actions-lock 拡張の --pin バージョンを更新",
      "managerFilePatterns": ["/^\\.github/workflows/actions-lock\\.yml$/"],
      "matchStrings": [
        "gh extension install (?<depName>github/gh-actions-lock) --pin (?<currentValue>v\\S+)"
      ],
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "sheldon plugins.toml: github + rev で固定したコミットを更新",
      "managerFilePatterns": ["/^\\.config/sheldon/plugins\\.toml$/"],
      "matchStrings": [
        "github\\s*=\\s*\"(?<depName>[^\"]+)\"\\s*[\\r\\n]+\\s*#\\s*branch:\\s*(?<currentValue>\\S+)\\s*[\\r\\n]+\\s*rev\\s*=\\s*\"(?<currentDigest>[0-9a-f]{40})\""
      ],
      "datasourceTemplate": "git-refs",
      "packageNameTemplate": "https://github.com/{{{depName}}}"
    }
  ]
}
